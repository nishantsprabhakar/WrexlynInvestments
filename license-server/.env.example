# Copy to .env and fill in before running locally or deploying.

# Connection string for a hosted Postgres database (Neon or Supabase free tier
# recommended — it persists independently of wherever this app itself runs, so a
# redeploy of the app never wipes registered users). Example shape:
# postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Plaintext admin password used to log into /admin. Pick something long and
# unique to this service — it is never sent anywhere but this server's own login
# check, and is compared with a constant-time comparison, but there is no
# hashing/salting here since it's a single fixed value you set directly, not a
# per-user password store.
ADMIN_PASSWORD=

PORT=8788
